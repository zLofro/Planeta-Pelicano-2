{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",

	"name": "FabricModTemplate",
	"description": "Basic mod template for Vermillion Productions modding environment.",
	"authors": [
		"zLofro"
	],
	"contact": {
		"sources": "https://github.com/VermillionProductions/FabricModTemplate"
	},

	"license": "MIT",
	"icon": "assets/modid/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			"vermillion.productions.Main"
		],
		"client": [
			"vermillion.productions.client.ModClient"
		]
	},
	"mixins": [
		"modid.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.15.10",
		"minecraft": "~1.20.6",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}